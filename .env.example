# ---------------------------------------------------------------------------
# Supabase backend (optional)
# Copy this file to .env.local and fill in your project's values.
# Without these, GentleLearn keeps working with data saved on the device.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Used once at sign-up to confirm the account automatically.
# Find it in Supabase → Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Real voice (optional). Pick one provider and add its key.
# Without a key the lesson player falls back to the browser's own voice.
# ---------------------------------------------------------------------------

# ElevenLabs — most natural, supports Indian languages.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# OpenAI text-to-speech.
OPENAI_API_KEY=

# Azure AI Speech.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
